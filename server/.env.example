# Optional. Required when STT_PROVIDER=openai. TTS can use TTS_API_KEY instead.
# OPENAI_API_KEY=your-openai-api-key

HERMES_API_KEY=your-hermes-api-key
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_MODEL=hermes-agent
HERMES_REQUEST_PREFIX=[channel:voice]
HERMES_CONVERSATION_ID_SOURCE=user_id
HERMES_STORE=true
# Optional. OpenAI Responses API reasoning.effort value: none, low, medium, high, xhigh.
# HERMES_REASONING_EFFORT=none

STT_PROVIDER=whisper_compatible
STT_BASE_URL=http://127.0.0.1:5003/v1
# STT_API_KEY=
STT_MODEL=whisperkit
STT_LANGUAGE=ja
STT_MIN_DATA_LENGTH=4096
STT_SAMPLE_RATE=16000
STT_TIMEOUT=30
# Local Apple Silicon Qwen3-ASR via provider/start.sh:
# STT_PROVIDER=qwen3_asr_mlx
# STT_BASE_URL=http://host.docker.internal:8766/v1
# STT_MODEL=Qwen/Qwen3-ASR-0.6B
# STT_RUNTIME_PORT=8766
# If STT_MODEL is a missing local path, provider/start.sh downloads STT_MODEL_REPO into it.
# STT_MODEL_REPO=Qwen/Qwen3-ASR-0.6B
# Optional domain hints for Qwen3-ASR, space-separated.
# STT_CONTEXT=Hermes AIAvatarKit StackChan
# STT_MAX_NEW_TOKENS=

VAD_PROVIDER=silero_stream
VAD_SEGMENT_SILENCE_THRESHOLD=0.05
VAD_USE_ITERATOR=true

# Optional background noise suppression. Runs on the finalized VAD utterance
# before voice authentication and STT.
AUDIO_ENHANCEMENT_ENABLED=false
AUDIO_ENHANCEMENT_PROVIDER=deepfilternet
# Optional model name or model directory, e.g. DeepFilterNet2.
# AUDIO_ENHANCEMENT_MODEL=
AUDIO_ENHANCEMENT_TIMEOUT=30
AUDIO_ENHANCEMENT_FAIL_OPEN=true
AUDIO_ENHANCEMENT_RECORD_RAW=true
AUDIO_ENHANCEMENT_RECORD_ENHANCED=true

# Optional voice authentication gate. Runs after VAD and before STT/LLM.
VOICE_AUTH_ENABLED=false
VOICE_AUTH_PROVIDER=wespeaker_mlx
VOICE_AUTH_BASE_URL=http://host.docker.internal:8765
# Optional. Defaults to AIAVATAR_API_KEY if empty.
# VOICE_AUTH_API_KEY=
VOICE_AUTH_MODEL_PATH=models/wespeaker-voxceleb-resnet34-LM-mlx
VOICE_AUTH_MODEL_REPO=Landon41/wespeaker-voxceleb-resnet34-LM-mlx
VOICE_AUTH_AUTO_DOWNLOAD_MODEL=true
VOICE_AUTH_PROFILE_DIR=data/voice_profiles
VOICE_AUTH_ENROLLMENT_DIR=data/voice_auth_enrollment
VOICE_AUTH_THRESHOLD=0.65
VOICE_AUTH_MIN_DURATION=1.2
VOICE_AUTH_SAMPLE_RATE=16000
VOICE_AUTH_REQUIRE_USER_ID=true
VOICE_AUTH_ALLOW_IDENTIFICATION=false
# Comma-separated internal voice profile names allowed to talk when identification is enabled.
# VOICE_AUTH_ALLOWED_USERS=user01
VOICE_AUTH_FAIL_OPEN=false
VOICE_AUTH_APPLY_CMN=true
VOICE_AUTH_RUNTIME_PORT=8765
# Host provider runtime start/status scripts use these optional paths.
# PROVIDER_STATE_DIR=.provider
# PROVIDER_LOG_DIR=.provider/logs

# Optional addressing gate. Runs after voice auth + STT and before accepted/LLM.
# Uses an OpenAI-compatible /chat/completions API with response_format=json_schema.
ADDRESSING_ENABLED=false
ADDRESSING_PROVIDER=openai_compatible
ADDRESSING_TARGET_NAMES=ロボ花音,ろぼかのん,ロボカノン,かのん,花音,カノン
# Optional. Defaults to HERMES_* only when no ADDRESSING provider override is set.
# ADDRESSING_BASE_URL=https://api.cerebras.ai/v1
# ADDRESSING_API_KEY=
# ADDRESSING_MODEL=gpt-oss-120b
# ADDRESSING_PRIMARY_NAME=ロボ花音
ADDRESSING_HISTORY_LIMIT=12
ADDRESSING_TIMEOUT=10
ADDRESSING_FAIL_OPEN=false
ADDRESSING_MIN_CONFIDENCE=0

LLM_PROVIDER=hermes

TTS_PROVIDER=aivis
# OpenAI-compatible TTS providers can use:
# TTS_PROVIDER=openai_compatible
# TTS_API_KEY=your-tts-api-key
# TTS_BASE_URL=http://127.0.0.1:8234/v1
# TTS_MODEL=irodori-tts
# TTS_SPEAKER=none
# TTS_RESPONSE_FORMAT=wav
# TTS_CACHE_DIR=tts_cache
# TTS_TIMEOUT=30
AIVIS_API_KEY=your-aivis-api-key
AIVIS_MODEL_UUID=261d7c95-11d4-4f0a-9053-4d28d3dd87ee
AIVIS_TTS_URL=https://api.aivis-project.com/v1/tts/synthesize
AIVIS_TTS_CACHE_DIR=aivis_tts_cache
AIVIS_TTS_TIMEOUT=30

# Optional. Set if you want to protect WebSocket/API/admin access.
# AIAVATAR_API_KEY=change-me
AIAVATAR_ADMIN_USER=admin

HOST=0.0.0.0
PORT=8000

# Optional. Set both for HTTPS.
# SSL_CERT_PATH=192.168.1.123.pem
# SSL_KEY_PATH=192.168.1.123-key.pem

MERGE_REQUEST_THRESHOLD=3.0
USE_INVOKE_QUEUE=true
SKIP_TTS_CHANNELS=discord
RESPONSE_AUDIO_CHUNK_SIZE=8192
DEBUG=true

# Optional Discord sync. The bot token needs Gateway message content access.
DISCORD_SYNC_ENABLED=false
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_CHANNEL_ID=123456789012345678
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional, but recommended if you want guild nicknames or guild avatars.
# DISCORD_GUILD_ID=123456789012345678
# Human-side and bot-side Discord IDs used to resolve webhook username/avatar_url.
# DISCORD_USER_ID=123456789012345678
# DISCORD_BOT_ID=234567890123456789
DISCORD_SYNC_USER_ID=robo-kanon-stack-chan
DISCORD_GATEWAY_SESSION_ID=discord:robo-kanon-stack-chan
DISCORD_IDENTITY_CACHE_TTL=300
DISCORD_VOICE_MESSAGE_PREFIX="🎙️ "
DISCORD_API_MESSAGE_PREFIX="📢 "
DISCORD_TYPING_INDICATOR_ENABLED=true
DISCORD_TYPING_INDICATOR_INTERVAL=8
